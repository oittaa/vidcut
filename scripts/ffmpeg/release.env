# The newest FFmpeg release, which the `release` target of
# scripts/ffmpeg-check.sh and .github/workflows/ffmpeg.yml build.
# To move to a newer one: download ffmpeg-X.Y.Z.tar.xz and its .asc from
# https://ffmpeg.org/releases/, check the signature against FFmpeg's release
# key (gpg fingerprint FCF9 86EA 15E6 E293 A564 4F10 B432 2F04 D676 58D8,
# https://ffmpeg.org/ffmpeg-devel.asc), and write its version and sha256 here.
FFMPEG_RELEASE=9.0.2
FFMPEG_RELEASE_SHA256=8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e
